# Adresse de l'API (backend Render), « /api » compris.
# En ligne (Vercel) : le navigateur appelle directement l'API (gros imports Excel, traitements longs).
# NEXT_PUBLIC_API_URL=https://dgrhas-backend.onrender.com/api
#
# Sur le poste : laisser vide ; les appels passent par le relais « /api » de Next
# vers BACKEND_URL (par défaut http://localhost:4000).
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://localhost:4000
